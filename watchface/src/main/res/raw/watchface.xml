<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="17:34:20" />
    <Scene backgroundColor="#ff000000">
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="@drawable/bg" />
        </PartImage>
        <!-- Date -->
        <PartText x="25" y="96" width="400" height="24">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#ffffffff">
                    <Template>%s, %s %s %s<Parameter expression="[DAY_OF_WEEK_F]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_F]" /><Parameter expression="[YEAR]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Time: blue hours, white minutes, blue colon -->
        <DigitalClock x="0" y="118" width="450" height="92">
            <TimeText format="hh" hourFormat="SYNC_TO_DEVICE" align="END"
                x="0" y="0" width="206" height="92">
                <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#ff3b82f6" />
            </TimeText>
            <TimeText format="mm" align="START"
                x="244" y="0" width="206" height="92">
                <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#ffffffff" />
            </TimeText>
        </DigitalClock>
        <PartDraw x="215" y="138" width="20" height="60">
            <Ellipse x="4" y="4" width="12" height="12"><Fill color="#ff3b82f6" /></Ellipse>
            <Ellipse x="4" y="40" width="12" height="12"><Fill color="#ff3b82f6" /></Ellipse>
        </PartDraw>

        <!-- Day-of-week strip -->
        <Condition>
            <Expressions>
                <Expression name="isDay2"><![CDATA[[DAY_OF_WEEK] == 2]]></Expression>
            </Expressions>
            <Compare expression="isDay2">
                <PartDraw x="38" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="36" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day2</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="36" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day2</Font></Text>
                </PartText>
            </Default>
        </Condition>
        <Condition>
            <Expressions>
                <Expression name="isDay3"><![CDATA[[DAY_OF_WEEK] == 3]]></Expression>
            </Expressions>
            <Compare expression="isDay3">
                <PartDraw x="92" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
