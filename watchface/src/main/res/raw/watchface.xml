<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="17:34:20" />
    <Scene backgroundColor="#ff000000">
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="@drawable/bg" />
        </PartImage>
        <!-- Current weather header -->
        <Condition>
            <Expressions>
                <Expression name="wxOk"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
            </Expressions>
            <Compare expression="wxOk">
                <Condition>
                    <Expressions>
                    <Expression name="clearDHdr"><![CDATA[([WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 8) && [WEATHER.IS_DAY]]]></Expression>
                    <Expression name="clearNHdr"><![CDATA[([WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 8) && ![WEATHER.IS_DAY]]]></Expression>
                    <Expression name="partlyDHdr"><![CDATA[([WEATHER.CONDITION] == 14 || [WEATHER.CONDITION] == 15) && [WEATHER.IS_DAY]]]></Expression>
                    <Expression name="partlyNHdr"><![CDATA[([WEATHER.CONDITION] == 14 || [WEATHER.CONDITION] == 15) && ![WEATHER.IS_DAY]]]></Expression>
                    <Expression name="rainHdr"><![CDATA[[WEATHER.CONDITION] == 4 || [WEATHER.CONDITION] == 6 || [WEATHER.CONDITION] == 12]]></Expression>
                    <Expression name="snowHdr"><![CDATA[[WEATHER.CONDITION] == 5 || [WEATHER.CONDITION] == 7 || [WEATHER.CONDITION] == 10 || [WEATHER.CONDITION] == 11]]></Expression>
                    <Expression name="thunderHdr"><![CDATA[[WEATHER.CONDITION] == 9]]></Expression>
                    </Expressions>
                    <Compare expression="clearDHdr">
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_clear" />
                        </PartImage>
                    </Compare>
                    <Compare expression="clearNHdr">
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_night" />
                        </PartImage>
                    </Compare>
                    <Compare expression="partlyDHdr">
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_partly" />
                        </PartImage>
                    </Compare>
                    <Compare expression="partlyNHdr">
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_night_cloud" />
                        </PartImage>
                    </Compare>
                    <Compare expression="rainHdr">
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_rain" />
                        </PartImage>
                    </Compare>
                    <Compare expression="snowHdr">
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_snow" />
                        </PartImage>
                    </Compare>
                    <Compare expression="thunderHdr">
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_thunder" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage x="155" y="30" width="48" height="48">
                            <Image resource="@drawable/wx_cloudy" />
                        </PartImage>
                    </Default>
                </Condition>
                <PartText x="208" y="34" width="110" height="46">
                    <Text align="START">
                        <Font family="SYNC_TO_DEVICE" size="40" weight="BOLD" color="#ffffffff">
                            <Template>%d°<Parameter expression="[WEATHER.TEMPERATURE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="75" y="40" width="300" height="24">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="16" color="#ff6b7280">--°</Font></Text>
                </PartText>
            </Default>
        </Condition>

        <!-- Date -->
        <PartText x="25" y="96" width="400" height="24">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#ffffffff">
                    <Template>%s, %s %s %s<Parameter expression="[DAY_OF_WEEK_F]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_F]" /><Parameter expression="[YEAR]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Time: blue hours, white minutes, blue colon -->
        <DigitalClock x="0" y="118" width="450" height="92">
            <TimeText format="hh" hourFormat="SYNC_TO_DEVICE" align="END"
                x="0" y="0" width="206" height="92">
                <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#ff3b82f6" />
            </TimeText>
            <TimeText format="mm" align="START"
                x="244" y="0" width="206" height="92">
                <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#ffffffff" />
            </TimeText>
        </DigitalClock>
        <PartDraw x="215" y="138" width="20" height="60">
            <Ellipse x="4" y="4" width="12" height="12"><Fill color="#ff3b82f6" /></Ellipse>
            <Ellipse x="4" y="40" width="12" height="12"><Fill color="#ff3b82f6" /></Ellipse>
        </PartDraw>

        <!-- Day-of-week strip -->
        <Condition>
            <Expressions>
                <Expression name="isDay2"><![CDATA[[DAY_OF_WEEK] == 2]]></Expression>
            </Expressions>
            <Compare expression="isDay2">
                <PartDraw x="38" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="36" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day2</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="36" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day2</Font></Text>
                </PartText>
            </Default>
        </Condition>
        <Condition>
            <Expressions>
                <Expression name="isDay3"><![CDATA[[DAY_OF_WEEK] == 3]]></Expression>
            </Expressions>
            <Compare expression="isDay3">
                <PartDraw x="92" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="90" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day3</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="90" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day3</Font></Text>
                </PartText>
            </Default>
        </Condition>
        <Condition>
            <Expressions>
                <Expression name="isDay4"><![CDATA[[DAY_OF_WEEK] == 4]]></Expression>
            </Expressions>
            <Compare expression="isDay4">
                <PartDraw x="146" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="144" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day4</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="144" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day4</Font></Text>
                </PartText>
            </Default>
        </Condition>
        <Condition>
            <Expressions>
                <Expression name="isDay5"><![CDATA[[DAY_OF_WEEK] == 5]]></Expression>
            </Expressions>
            <Compare expression="isDay5">
                <PartDraw x="200" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="198" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day5</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="198" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day5</Font></Text>
                </PartText>
            </Default>
        </Condition>
        <Condition>
            <Expressions>
                <Expression name="isDay6"><![CDATA[[DAY_OF_WEEK] == 6]]></Expression>
            </Expressions>
            <Compare expression="isDay6">
                <PartDraw x="254" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="252" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day6</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="252" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day6</Font></Text>
                </PartText>
            </Default>
        </Condition>
        <Condition>
            <Expressions>
                <Expression name="isDay7"><![CDATA[[DAY_OF_WEEK] == 7]]></Expression>
            </Expressions>
            <Compare expression="isDay7">
                <PartDraw x="308" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="306" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day7</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="306" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day7</Font></Text>
                </PartText>
            </Default>
        </Condition>
        <Condition>
            <Expressions>
                <Expression name="isDay1"><![CDATA[[DAY_OF_WEEK] == 1]]></Expression>
            </Expressions>
            <Compare expression="isDay1">
                <PartDraw x="362" y="212" width="50" height="28">
                    <RoundRectangle x="1" y="1" width="48" height="26" cornerRadiusX="13" cornerRadiusY="13">
                        <Stroke color="#ff3b82f6" thickness="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="360" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ff3b82f6">@string/day1</Font></Text>
                </PartText>
            </Compare>
            <Default>
                <PartText x="360" y="216" width="54" height="20">
                    <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="15" color="#ffd1d5db">@string/day1</Font></Text>
                </PartText>
            </Default>
        </Condition>
    </Scene>
</WatchFace>
